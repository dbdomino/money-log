<?xml version="1.0" encoding="UTF-8"?>
<!--
  화면 모듈 로깅. 헌장 원칙 IV — 콘솔과 파일에 동시에 남긴다.

  이 파일이 logback.xml 을 대신한다. 이전 logback.xml 은 전체를 <springProfile name="default">
  로 감싸고 있었는데, 그 상태로는 로그가 한 줄도 남지 않았다. 이유가 둘 겹쳐 있었다.
    1. <springProfile> 은 Spring 확장 태그라 logback.xml 에서는 해석되지 않는다.
       logback.xml 은 Spring 이 개입하기 전에 로드된다.
    2. 앱이 postgresql 프로필로 떠서 default 조건도 맞지 않았다.
  어느 쪽이든 appender 가 하나도 붙지 않고 오류도 나지 않는다 — 조용히 사라지는 실패였다.

  파일명을 logback-spring.xml 로 둔 이유가 1번이다. 이제 <springProperty> 로 앱 이름을
  읽어 로그 파일명에 쓴다.
-->
<configuration>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name"
                    defaultValue="money-app"/>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    <property name="LOG_DIR" value="logs"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="STDOUT"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- 백엔드 호출 로그(BackendApiClient)가 나오는 자리. 토큰 마스킹은 그 클래스가 한다. -->
    <logger name="com.dbdomino.moneylog" level="info"/>
    <logger name="org.springframework" level="warn"/>

</configuration>
